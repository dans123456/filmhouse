rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Movies catalog: Read and write allowed for admin panel updates
    match /movies/{movie} {
      allow read, write: if true;
    }
    
    // Settings: Client-side access for app configurations
    match /settings/{setting} {
      // Restrict internal system documents and sensitive bot credentials from public client access
      allow read, write: if setting != 'backup' && setting != 'new_episodes_notified' && setting != 'telegram';
    }
    
    // Users: Read and write allowed for user profiles and points
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Requests: Read and write allowed for user requests and admin fulfillment
    match /requests/{requestId} {
      allow read, write: if true;
    }
    
    // Feedbacks: Create-only (cannot read, update or delete other feedbacks from web client)
    match /feedbacks/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // Activity Logs: Read and create allowed for admin panel rankings/analytics
    match /activity_logs/{logId} {
      allow create, read: if true;
      allow update, delete: if false;
    }
    
    // Admin Reminders: Create-only for admin triggered reminders
    match /admin_reminders/{reminderId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // Default fallback: Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
