# Film House Environment Configuration Template
# Store this file as .env on your Ubuntu server (/home/ubuntu/filmhouse-bot/.env)

# Public Telegram Bot Token (for regular users)
BOT_TOKEN=your_telegram_bot_token_here

# Dedicated Admin Telegram Bot Token (for admin alerts, backups, logs)
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Master Admin IDs (comma-separated)
ADMIN_IDS=your_telegram_user_id

# Telegram Channels Configuration
# Updates & Release Channel (5-day auto-delete timer, receives movie/series release updates & download links)
UPDATES_CHANNEL_ID=-1004272961286

# Main Community Channel (clean, memes, recommendations, no direct download links)
MAIN_CHANNEL_ID=-1002098683402
